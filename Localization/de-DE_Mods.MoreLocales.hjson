Configs: {
	Headers: {
		Fonts: Schrifteinstellungen
		// Features: Other Features
	}

	ClientSideConfig: {
		DisplayName: Clienteinstellungen

		ForcedFont: {
			Label: Erzwinge Lokalisierstes Schriftsystem
			Tooltip:
				'''
				Zwingt das Spiel, dieses Schriftsystem zu nutzen, unabhängig von den Spracheinstellungen.
				Die Standardoption ist {$Configs.LocalizedFont.None.Label} , das heißt, das Schriftsystem passt sich an die Sprache an.
				'''
		}

		LocalizedPrefixPlacement: {
			// Label: Smart Prefix Position
			// Tooltip: Changes the position of an item's prefix in certain languages
		}

		LocalizedPrefixGenderPluralization: {
			// Label: Smart Prefix Inflection
			// Tooltip: Changes the inflection of an item's prefix depending on the item in certain languages
		}
	}

	LocalizedFont: {
		Tooltip: The type of font the game uses. Small changes to the font for different languages are necessary due to Unicode restrictions

		None: {
			Label: Keine
			// Tooltip: ""
		}

		Default: {
			Label: Standard
			// Tooltip: ""
		}

		Japanese: {
			Label: Japanisch
			// Tooltip: ""
		}

		Korean: {
			Label: Koreanisch
			// Tooltip: ""
		}
	}
}

