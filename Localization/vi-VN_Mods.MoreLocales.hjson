		ForcedFont: {
			Label: Buộc Thể Loại Phông
			Tooltip: Buộc game phải sử dung loại phông này, bỏ qua chế độ ngôn ngữ hiện tại. Mặc định là {$Configs.LocalizedFont.None.Label}, nghĩa là phông sẽ thay đổi linh hoạt cho với ngôn ngữ được chọn.
		}

		LocalizedPrefixPlacement: {
			// Label: Smart Prefix Position
			// Tooltip: Changes the position of an item's prefix in certain languages
		}

		LocalizedPrefixGenderPluralization: {
			// Label: Smart Prefix Inflection
			// Tooltip: Changes the inflection of an item's prefix depending on the item in certain languages
		}
	}

	LocalizedFont: {
		Tooltip: Thể loại phông mà game dùng. Một vài thay đổi nhỏ tới các ngôn ngữ là cần thiết do hạn chế của Unicode

