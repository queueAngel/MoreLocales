Configs: {
	Headers: {
		Fonts: Configuración de fuentes
		Features: Otras características
	}

	ClientSideConfig: {
		DisplayName: Configuración del cliente

		ForcedFont: {
			Label: Tipo de fuente localizada forzada
			Tooltip: Obliga al juego a usar este tipo de fuente localizada, sin importar el idioma elegido. Esto es {$Configs.LocalizedFont.None.Label} por defecto, lo que hará que la fuente cambie dinámicamente dependiendo en el idioma elegido
		}

		LocalizedPrefixPlacement: {
			Label: Posición inteligente de los modificadores
			Tooltip: Cambia la posición del modificador de un objeto en ciertos idiomas (Incluyendo el Español)
		}

		LocalizedPrefixGenderPluralization: {
			Label: Inflección inteligente de los modificadores
			Tooltip: Cambia la inflección (forma) de los modificadores dependiendo del objeto en ciertos idiomas (Incluyendo el Español)
		}
	}

	LocalizedFont: {
		Tooltip: El tipo de fuente que utiliza el juego. Los cambios pequeños de fuente para diferentes idiomas son necesarios debido a las restricciones de Unicode

		None: {
			Label: Ninguna
			// Tooltip: ""
		}

		Default: {
			Label: Por defecto
			// Tooltip: ""
		}

		Japanese: {
			Label: Japonesa
			// Tooltip: ""
		}

		Korean: {
			Label: Coreana
			// Tooltip: ""
		}
	}
}

