Configs: {
	Headers: {
		Fonts: 字体配置
		// Features: Other Features
	}

	ClientSideConfig: {
		DisplayName: 客户端配置

		ForcedFont: {
			Label: 强制使用本地字体
			Tooltip:
				'''
				强制游戏使用本地字体，忽略当前的语言设置
				默认为{$Configs.LocalizedFont.None.Label}
				这意味着字体将会跟随所选语言而自动变化
				'''
		}

		LocalizedPrefixPlacement: {
			// Label: Smart Prefix Position
			// Tooltip: Changes the position of an item's prefix in certain languages
		}

		LocalizedPrefixGenderPluralization: {
			// Label: Smart Prefix Inflection
			// Tooltip: Changes the inflection of an item's prefix depending on the item in certain languages
		}
	}

	LocalizedFont: {
		Tooltip:
			'''
			游戏使用的字体
			由于Unicode和Terraria的限制
			需要根据语言来选择合适的字体
			'''

		None: {
			Label: 无
			// Tooltip: ""
		}

		Default: {
			Label: 默认
			// Tooltip: ""
		}

		Japanese: {
			Label: 日语
			// Tooltip: ""
		}

		Korean: {
			Label: 韩语
			// Tooltip: ""
		}
	}
}

