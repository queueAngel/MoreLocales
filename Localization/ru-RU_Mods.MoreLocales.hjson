Configs: {
	Headers: {
		Fonts: Настройки шрифта
		// Features: Other Features
	}

	ClientSideConfig: {
		DisplayName: Клиентская конфигурация

		ForcedFont: {
			Label: Принудительное использование шрифта текущей локализации
			Tooltip:
				'''
				Заставляет игру использовать данный тип шрифта, не обращая внимания на текущие языковые настройки.
				По умолчанию отключено, что означает, что шрифт будет динамически меняться в зависимости от выбранного языка.
				'''
		}

		LocalizedPrefixPlacement: {
			// Label: Smart Prefix Position
			// Tooltip: Changes the position of an item's prefix in certain languages
		}

		LocalizedPrefixGenderPluralization: {
			// Label: Smart Prefix Inflection
			// Tooltip: Changes the inflection of an item's prefix depending on the item in certain languages
		}
	}

	LocalizedFont: {
		Tooltip: Тип шрифта, используемого в игре. Небольшие изменения шрифта для разных языков необходимы из-за ограничений Unicode.

		None: {
			Label: нет
			// Tooltip: ""
		}

		Default: {
			Label: обычный
			// Tooltip: ""
		}

		Japanese: {
			Label: японский
			// Tooltip: ""
		}

		Korean: {
			Label: корейский
			// Tooltip: ""
		}
	}
}

