Configs: {
	Headers: {
		Fonts: Налады шрыфтоў
		Features: Іншыя функцыі
	}

	ClientSideConfig: {
		DisplayName: Канфігурацыя кліента

		ForcedFont: {
			Label: Прымусовае выкарыстанне шрыфту
			Tooltip:
				'''
				Гэты тып шрыфту будзе ўжывацца прымусова, ігнаруючы бягучыя моўныя налады.
				Прадвызначаны выкарыстоўваецца {$Configs.LocalizedFont.None.Label} — шрыфт будзе дынамічна мяняцца ў залежнасці ад абранай мовы.
				'''
		}

		LocalizedPrefixPlacement: {
			Label: Разумнае размяшчэнне прэфікса
			Tooltip: Змяняе размяшчэнне прэфікса прадметаў ў некаторых мовах
		}

		LocalizedPrefixGenderPluralization: {
			Label: Разумнае скланенне прэфікса
			Tooltip: Змяняе ў некаторых мовах скланенне прэфікса ў залежнасці ад прадмета 
		}
	}

	LocalizedFont: {
		Tooltip: Тып шрыфту, які выкарыстоўвае гульня. Невялікія змены шрыфту для розных моў неабходныя з-за абмежаванняў Unicode

		None: {
			Label: Няма
			Tooltip: ""
		}

		Default: {
			Label: Прадвызначаны
			Tooltip: ""
		}

		Japanese: {
			Label: Японскі
			Tooltip: ""
		}

		Korean: {
			Label: Карэйскі
			Tooltip: ""
		}
	}
}

