Misc: {
	Error: {
		FontPatchingError:
			'''
			Падчас абнаўлення шрыфтоў адбылася памылка.
			Лакалізаваныя шрыфты не будуць адлюстроўвацца як мае быць.
			Калі ласка, неадкладна паведаміце пра памылку распрацоўшчыкам Localization Plus.
			Тым часам можаце паспрабаваць перазапусціць гульню.
			Каб працягнуць, Націсніце «Добра».
			'''
		InvalidGrammaticalGender: Персанаж або назва «{0}» не мае адпаведнага граматычнаму роду.
		InvalidGrammaticalNumber: Персанаж або назва «{0}» не мае адпаведнага прадвызначанага граматычнаму ліку.
		InvalidInflection: Назва «{0}» не распазнана як дапушчальная. Пераканайцеся, што яна змяшчае і род, і лік.
		LPlusNone: Невядомая памылка пры разборы файла «{0}»: пазіцыя {1}, радок '{2}'.
		LPlusEntryOutside: Памылка ў файле «{0}»: запіс {2} знаходзіцца па-за раздзелам.
		LPlusSubsectionWithoutSection: Памылка ў файле «{0}»: падраздзел 	«{2}» не знаходзіцца ні ў якім раздзеле.
		LPlusInvalidSectionOrSubsection: Памылка ў файле «{0}»: раздзел або падраздзел «{2}» не быў распазнаны або мае няслушны фармат.
		LPlusSectionTagsUnexpected: Памылка ў файле {0}: адзін або некалькі цэтлікаў у раздзеле або падраздзеле «{2}» не былі распазнаны або не такія, як чакалася.
		LPlusSectionTagsUnexpectedCount: Памылка ў файле «{0}»: колькасць тэгаў у раздзеле або падраздзеле «{2}» не супала з чаканай.
		LPlusMalformedEntry: Запіс «{2}» мае няслушны фармат значэння.
		LPlusUnexpectedEntry: Памылка ў файле «{0}»: колькасць запісаў у раздзеле або падраздзеле «{2}» не супала з чаканай.
		LPlusBadEntryFormat: Памылка ў файле «{0}»: запіс у раздзеле або падраздзеле «{2}» не адпавядае правільнаму фармату. Калі ласка, перачытайце дакументацыю файла са словаформамі.
		LPlusBadSimpleMatch: Радок «{2}» не з'яўляецца дапушчальным простым узорам супадзення. Калі ласка, перачытайце дакументацыю файла са словаформамі.
		LPlusOverrideOverlap: Памылка ў файле «{0}»: некалькі словаформ для прадмета «{2}» ствараюць канфлікт. Калі вы выкарыстоўваеце параметр 'Inflection:', не ўжывайце адначасова 'Gender:' або 'Number:', і наадварот.
	}
}

Commands: {
	TestPrefixesCommand: {
		Error: {
			LanguageNoInflections: Бягучая мова ({0}) з  кодам «{1}», не мае файла са словаформамі; формы прэфіксаў будуць як прадвызначаныя.
			NoArgs:
				'''
				Калі ласка, вызначыце слушны ідэнтыфікатар прадмета.
				Для звычайных прадметаў гэта можа быць лікавы ID або ўнутраная назва.
				Для прадметаў з мадыфікацый гэта павінна быць унутраная назва ў адпаведным фармаце: ModInternalName/ItemInternalName
				'''
			UnknownItem:
				'''
				Прадмет «{0}» не быў знойдзены.
				{$NoArgs}
				'''
		}

		Success.BasicInfo:
			'''
			Прадмет «{0}» мае скланенне {1} з парадыгмай {2}.
			Вось як будуць выглядаць прэфіксы:
			'''
	}

	ItemInflectionsCommand: {
		Error.LanguageNoInflections: Бягучая мова ({0}) з  кодам «{1}», не мае файла са словаформамі; усе прадметы будуць мець прадвызначанае скланенне.
		Advice: Гэтая каманда вельмі хутка засмечвае чат. Лепш выкарыстоўваць яе праз кансоль tModLoader. Гэта можна зрабіць у шматкарыстальніцкай гульні або дадаўшы -c пасля самой каманды.
	}
}
